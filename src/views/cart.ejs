<%- include("partials/header") %>

<main>
    <h2>Cart</h2>
    <p>Review the LEGO listings you are interested in purchasing.</p>

    <section class="cart-layout">
        <div class="cart-items">
            <h3>Cart Items</h3>
            <% if(cart.length == 0) { %>
                <div class="cart-empty">
                    <h4>Your cart is empty</h4>
                    <p>Add a listing from the products page to see it here.</p>
                    <a href="/products">Browse Products</a>
                </div>
            <% } else { %>
                <% cart.forEach(item => { %>
                    <article class="cart-item">
                        <img src="<%= item.listing.image_url %>" alt="<%= item.listing.listing_name %> image">
                        <div class="cart-item-details">
                            <h4><%= item.listing.listing_name %></h4>
                            <p>Quantity: <%= item.quantity %></p>
                            <p>Price: $<%= Number(item.listing.price).toFixed(2) %></p>
                            <p>Item subtotal: $<%= Number(item.itemSubtotal).toFixed(2) %></p>
                        </div>
                    </article>
                <% }); %>
            <% } %>
        </div>

        <aside class="cart-summary">
            <h3>Order Summary</h3>

            <div class="summary-line">
                <span>Subtotal</span>
                <span>$<%= Number(subtotal).toFixed(2) %></span>
            </div>

            <div class="summary-line">
                <span>Sales Tax</span>
                <span>$<%= Number(salesTax).toFixed(2) %></span>
            </div>

            <div class="summary-line">
                <span>Shipping</span>
                <span>$<%= Number(shipping).toFixed(2) %></span>
            </div>

            <div class="summary-line">
                <span>Estimated total</span>
                <strong>$<%= Number(total).toFixed(2) %></strong>
            </div>
            <form method="POST" action="/orders">
                <button type="submit">
                    Checkout
                </button>
            </form>
        </aside>
    </section>
</main>

<%- include("partials/footer") %>
